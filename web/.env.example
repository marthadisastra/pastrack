WEB_ADDR=127.0.0.1:18089
# Random secret, at least 32 characters.
SESSION_SECRET=
COOKIE_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pastrack
DB_USER=gps_listener
DB_PASSWORD=

# First DBA bootstrap only; application login uses web_users after migration.
# WEB_USER=admin
# WEB_PASSWORD_HASH=<legacy SHA256 hex for the bootstrap password>
# Same private socket path as the tracker receiver.
REALTIME_SOCKET_PATH=/tmp/pastrack/live.sock
