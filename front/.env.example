# Most fleet/module screens remain demo during staged API integration.
# All Assets uses the authenticated vehicle registry by default; set VITE_ASSETS_MODE=demo to preview it offline.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1
# Authentication uses Go even when fleet/module screens are demo.
VITE_AUTH_MODE=server
VITE_AUTH_API_BASE_URL=/api/v1
# Local Vite proxies authentication to the live Go service over HTTPS.
AUTH_PROXY_TARGET=https://toko.azlaundry.my.id
# Isolated local Go development: AUTH_PROXY_TARGET=http://127.0.0.1:18094
# Production deployment serves Vue at /app/.
VITE_BASE_PATH=/
VITE_STALE_AFTER_MS=60000
# Offline UI development only: VITE_AUTH_MODE=demo
# Optional business SSE URL after enabling real fleet services:
# VITE_REALTIME_URL=/api/v1/realtime?watch=fleet/live&watch=notifications%3Flimit%3D100
