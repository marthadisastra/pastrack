{
  "schemaVersion": 1,
  "id": "ext.queclink.kinematics",
  "name": "Kinematic Dynamics & Shock",
  "version": "1.8.0",
  "kind": "extension",
  "icon": "speed",
  "description": "Queclink 3-axis MEMS accelerometer G-force audit and harsh braking.",
  "minCore": "4.8.0",
  "coreMajor": 4,
  "dependencies": ["core.gis.tracker"],
  "paths": ["/driving-behavior"],
  "permissions": ["kinematics.view"],
  "topics": ["vehicle.impact"],
  "config": [
    {
      "key": "shockThreshold",
      "label": "Impact threshold (g)",
      "type": "number",
      "min": 0.1,
      "max": 10,
      "step": 0.05,
      "default": 0.55
    }
  ],
  "entry": null
}
