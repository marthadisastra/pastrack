{
  "schemaVersion": 1,
  "id": "ext.fleet.maintenance",
  "name": "Preventive Maintenance & Work Orders",
  "version": "1.5.1",
  "kind": "extension",
  "icon": "construction",
  "description": "Odometer and ACC DI1 running hours automated service triggers.",
  "minCore": "4.8.0",
  "coreMajor": 4,
  "dependencies": ["core.gis.tracker"],
  "paths": ["/maintenance"],
  "permissions": ["maintenance.view", "maintenance.manage"],
  "topics": ["work-order"],
  "config": [
    {
      "key": "leadDistance",
      "label": "Upcoming service window (km)",
      "type": "number",
      "min": 50,
      "max": 10000,
      "default": 500
    }
  ],
  "entry": "./maintenance/views/MaintenanceView.vue"
}
