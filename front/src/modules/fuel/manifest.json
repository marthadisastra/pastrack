{
  "schemaVersion": 1,
  "id": "telemetry.cfs300b.ble",
  "name": "CFS300B Fuel Intelligence",
  "version": "2.1.2",
  "kind": "core",
  "icon": "local_gas_station",
  "description": "BLE 5.0 capacitive probe telemetry, anti-slosh filtering and siphon alarm.",
